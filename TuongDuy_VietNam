local function createSearchDropdown(tabName, titleText, isBorder)
    local tabFrame = tabs[tabName]
    if not tabFrame then return end

    local dropdownFrame = Instance.new("Frame")
    dropdownFrame.Name = titleText:gsub("%s+", "") .. "Dropdown"
    dropdownFrame.Size = UDim2.new(1, -10, 0, 50)
    dropdownFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    dropdownFrame.BackgroundTransparency = 0.90
    dropdownFrame.ClipsDescendants = true
    dropdownFrame.ZIndex = 60
    dropdownFrame.Parent = tabFrame

    Instance.new("UICorner", dropdownFrame).CornerRadius = UDim.new(0, 10)
    local dStroke = Instance.new("UIStroke")
    dStroke.Color = Color3.fromRGB(255, 255, 255)
    dStroke.Transparency = 0.75
    dStroke.Parent = dropdownFrame

    local headerBtn = Instance.new("TextButton")
    headerBtn.Size = UDim2.new(1, 0, 0, 50)
    headerBtn.BackgroundTransparency = 1
    headerBtn.Text = ""
    headerBtn.AutoButtonColor = false
    headerBtn.ZIndex = 61
    headerBtn.Parent = dropdownFrame

    local titleLbl = Instance.new("TextLabel")
    titleLbl.Size = UDim2.new(0, 220, 1, 0)
    titleLbl.Position = UDim2.new(0, 15, 0, 0)
    titleLbl.BackgroundTransparency = 1
    titleLbl.Text = titleText
    titleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 14
    titleLbl.TextXAlignment = Enum.TextXAlignment.Left
    titleLbl.ZIndex = 62
    titleLbl.Parent = headerBtn

    local selectedLbl = Instance.new("TextLabel")
    selectedLbl.Size = UDim2.new(0, 250, 1, 0)
    selectedLbl.Position = UDim2.new(1, -260, 0, 0)
    selectedLbl.BackgroundTransparency = 1
    selectedLbl.Text = isBorder and "Cầu Vồng (Rainbow) ▾" or "Xanh Đậm (Default) ▾"
    selectedLbl.TextColor3 = Color3.fromRGB(0, 170, 255)
    selectedLbl.Font = Enum.Font.GothamMedium
    selectedLbl.TextSize = 13
    selectedLbl.TextXAlignment = Enum.TextXAlignment.Right
    selectedLbl.ZIndex = 62
    selectedLbl.Parent = headerBtn

    local colorSearchBox = Instance.new("TextBox")
    colorSearchBox.Name = "ColorSearchBox"
    colorSearchBox.Size = UDim2.new(1, -30, 0, 32)
    colorSearchBox.Position = UDim2.new(0, 15, 0, 55)
    colorSearchBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    colorSearchBox.BackgroundTransparency = 0.88
    colorSearchBox.PlaceholderText = "🔎 Nhập tên màu để tìm..."
    colorSearchBox.PlaceholderColor3 = Color3.fromRGB(160, 170, 190)
    colorSearchBox.Text = ""
    colorSearchBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    colorSearchBox.Font = Enum.Font.Gotham
    colorSearchBox.TextSize = 12
    colorSearchBox.ZIndex = 62
    colorSearchBox.Parent = dropdownFrame

    Instance.new("UICorner", colorSearchBox).CornerRadius = UDim.new(0, 6)

    local optionContainer = Instance.new("ScrollingFrame")
    optionContainer.Size = UDim2.new(1, -30, 0, 210)
    optionContainer.Position = UDim2.new(0, 15, 0, 95)
    optionContainer.BackgroundTransparency = 1
    optionContainer.BorderSizePixel = 0
    optionContainer.ScrollBarThickness = 3
    optionContainer.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
    optionContainer.ZIndex = 62
    optionContainer.Parent = dropdownFrame

    local optLayout = Instance.new("UIListLayout")
    optLayout.Padding = UDim.new(0, 4)
    optLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optLayout.Parent = optionContainer

    optLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        optionContainer.CanvasSize = UDim2.new(0, 0, 0, optLayout.AbsoluteContentSize.Y + 10)
    end)

    local isOpen = false
    headerBtn.MouseEnter:Connect(function()
        TweenService:Create(dropdownFrame, TweenInfo.new(0.15), {
            BackgroundTransparency = 0.85
        }):Play()
    end)
    headerBtn.MouseLeave:Connect(function()
        TweenService:Create(dropdownFrame, TweenInfo.new(0.15), {
            BackgroundTransparency = 0.90
        }):Play()
    end)

    headerBtn.MouseButton1Click:Connect(function()
        playSfx(SFX_CLICK, 0.3)
        isOpen = not isOpen
        TweenService:Create(dropdownFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = isOpen and UDim2.new(1, -10, 0, 320) or UDim2.new(1, -10, 0, 50)
        }):Play()
    end)

    local createdColorButtons = {}

    if isBorder then
        local rainbowBtn = Instance.new("TextButton")
        rainbowBtn.Size = UDim2.new(1, -5, 0, 32)
        rainbowBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        rainbowBtn.BackgroundTransparency = 0.92
