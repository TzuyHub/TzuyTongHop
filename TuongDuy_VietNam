    tLbl.TextSize = 17
    tLbl.TextXAlignment = Enum.TextXAlignment.Left
    tLbl.TextYAlignment = Enum.TextYAlignment.Center
    tLbl.TextStrokeTransparency = 0.3
    tLbl.TextStrokeColor3 = TEXT_WHITE
    tLbl.ZIndex = 54
    tLbl.Parent = btn

    local track = Instance.new("Frame")
    track.Size = UDim2.new(0, 46, 0, 24)
    track.Position = UDim2.new(1, -60, 0.5, -12)
    track.BackgroundColor3 = state and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(120, 125, 135)
    track.BorderSizePixel = 0
    track.ZIndex = 54
    track.Parent = btn
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(0, 20, 0, 20)
    thumb.Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    thumb.ZIndex = 55
    thumb.Parent = track
    Instance.new("UICorner", thumb).CornerRadius = UDim.new(1, 0)

    table.insert(allScriptButtons, {
        Button = btn, Stroke = stroke,
        Title = string.lower(title), Desc = string.lower(desc or ""),
        TabName = tabName, IsToggle = true
    })

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18), { BackgroundTransparency = 0.7 }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.18), { Transparency = 0.4 }):Play()
    end)

    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18), { BackgroundTransparency = 0.82 }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.18), { Transparency = 0.7 }):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        playSfx(SFX_CLICK, 0.35, 1.05)
        state = not state

        TweenService:Create(track, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            BackgroundColor3 = state and Color3.fromRGB(0, 170, 100) or Color3.fromRGB(120, 125, 135)
        }):Play()
        TweenService:Create(thumb, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = state and UDim2.new(1, -22, 0.5, -10) or UDim2.new(0, 2, 0.5, -10)
        }):Play()

        callback(state)
    end)

    btn.Parent = tabFrame
end

