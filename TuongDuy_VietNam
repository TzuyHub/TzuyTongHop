local tabs = {}
local tabButtons = {}
local activeTab = nil
local allScriptButtons = {}

local function createTabContent(name)
    local sf = Instance.new("ScrollingFrame")
    sf.Name = name .. "Content"
    sf.Size = UDim2.new(1, 0, 1, 0)
    sf.BackgroundTransparency = 1
    sf.BorderSizePixel = 0
    sf.ScrollBarThickness = 4
    sf.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
    sf.Visible = false
    sf.ZIndex = 52
    sf.Parent = contentContainer

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = sf

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        sf.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)

    tabs[name] = sf
    return sf
end

local function switchTab(name)
    for tabName, frame in pairs(tabs) do
        frame.Visible = (tabName == name)
    end
    for btnName, btn in pairs(tabButtons) do
        if btnName == name then
            btn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
            btn.BackgroundTransparency = 0.25
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            btn.BackgroundTransparency = 0.93
            btn.TextColor3 = Color3.fromRGB(200, 210, 230)
        end
    end
    activeTab = name
end

local function addSidebarButton(name, iconText)
    local btn = Instance.new("TextButton")
    btn.Name = name .. "TabBtn"
    btn.Size = UDim2.new(1, -5, 0, 42)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundTransparency = 0.93
    btn.Text = "  " .. (iconText or "📁") .. "   " .. name
    btn.TextColor3 = Color3.fromRGB(200, 210, 230)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 52
    btn.AutoButtonColor = false

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn

    btn.MouseEnter:Connect(function()
        if activeTab ~= name then
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundTransparency = 0.85
            }):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        if activeTab ~= name then
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundTransparency = 0.93
            }):Play()
        end
    end)

    btn.MouseButton1Click:Connect(function()
        playSfx(SFX_CLICK, 0.3)
        searchBox.Text = ""
        switchTab(name)
    end)

    btn.Parent = sidebar
    tabButtons[name] = btn
    createTabContent(name)
end

