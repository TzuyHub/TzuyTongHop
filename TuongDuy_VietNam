    }):Play()
end

local function shatterText()
    baKhiSplash.TextTransparency = 1
    playSfx("rbxassetid://876939830", 0.55, 1.2)

    -- HIỆN NÚT BẤM SAU KHI CHỮ VỠ TAN 0.1s
    task.delay(0.1, function()
        if button then
            button.Visible = true
        end
    end)

    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    flash.BackgroundTransparency = 0.25
    flash.BorderSizePixel = 0
    flash.ZIndex = 201
    flash.Parent = screenGui
    TweenService:Create(flash, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 1
    }):Play()
    task.delay(0.4, function() if flash and flash.Parent then flash:Destroy() end end)

    splashOverlay.BackgroundTransparency = 0.9
    TweenService:Create(splashOverlay, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        BackgroundTransparency = 1
    }):Play()

    local PARTICLE_COUNT = 1600
    local BATCHES = 4
    local perBatch = PARTICLE_COUNT / BATCHES

    local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
    local MAX_DISTANCE = math.sqrt(vp.X * vp.X + vp.Y * vp.Y) * 0.5

    for b = 1, BATCHES do
        task.delay((b - 1) * 0.05, function()
            for i = 1, perBatch do
                local p = Instance.new("Frame")
                p.AnchorPoint = Vector2.new(0.5, 0.5)
                local size = math.random(1, 3)
                p.Size = UDim2.new(0, size, 0, size)
                p.Position = UDim2.new(0.5, math.random(-380, 380), 0.5, math.random(-70, 70))
                local roll = math.random()
                local color
                if roll < 0.55 then
                    color = Color3.fromRGB(255, math.random(190, 245), math.random(0, 80))
                elseif roll < 0.78 then
                    color = Color3.fromRGB(255, math.random(100, 170), 0)
                elseif roll < 0.92 then
                    color = Color3.fromRGB(255, 240, 200)
                else
                    color = Color3.fromRGB(255, math.random(60, 120), 0)
                end
                p.BackgroundColor3 = color
                p.BackgroundTransparency = 0
                p.BorderSizePixel = 0
                p.ZIndex = 202
                p.Parent = screenGui
                Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)

                local angle    = math.random() * math.pi * 2
                local distance = math.random(220, math.floor(MAX_DISTANCE))
                local dx = math.cos(angle) * distance
                local dy = math.sin(angle) * distance
                if math.random() < 0.40 then dy = dy + math.random(100, 500) end

                local dur  = math.random(180, 510) / 100
                local ease = (math.random() < 0.5) and Enum.EasingStyle.Quad or Enum.EasingStyle.Quart

                TweenService:Create(p, TweenInfo.new(dur, ease, Enum.EasingDirection.Out), {
                    Position = UDim2.new(0.5, dx, 0.5, dy),
                    BackgroundTransparency = 1,
                    Size = UDim2.new(0, 1, 0, 1)
                }):Play()

                task.delay(dur + 0.2, function() if p and p.Parent then p:Destroy() end end)
            end
        end)
    end

    task.delay(6, function()
        if splashOverlay and splashOverlay.Parent then splashOverlay:Destroy() end
        if baKhiSplash  and baKhiSplash.Parent  then baKhiSplash:Destroy()  end
    end)
end

