local function addScriptButton(tabName, title, desc, callback)
    local tabFrame = tabs[tabName]
    if not tabFrame then return end

    local btn = Instance.new("TextButton")
    btn.Name = title .. "Button"
    btn.Size = UDim2.new(1, -10, 0, 52)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundTransparency = 0.82
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.ZIndex = 53

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 0, 0)
    stroke.Transparency = 0.7
    stroke.Thickness = 1
    stroke.Parent = btn

    local tLbl = Instance.new("TextLabel")
    tLbl.Size = UDim2.new(1, -30, 1, 0)
    tLbl.Position = UDim2.new(0, 15, 0, 0)
    tLbl.BackgroundTransparency = 1
    tLbl.Text = title
    tLbl.TextColor3 = TEXT_BLUE_BRIGHT
    tLbl.Font = Enum.Font.GothamBlack
    tLbl.TextSize = 17
    tLbl.TextXAlignment = Enum.TextXAlignment.Left
    tLbl.TextYAlignment = Enum.TextYAlignment.Center
    tLbl.TextStrokeTransparency = 0.3
    tLbl.TextStrokeColor3 = TEXT_WHITE
    tLbl.ZIndex = 54
    tLbl.Parent = btn

    local itemData = {
        Button = btn, Stroke = stroke,
        Title = string.lower(title), Desc = string.lower(desc or ""),
        TabName = tabName
    }
    table.insert(allScriptButtons, itemData)

    btn.MouseEnter:Connect(function()
        if not btn:GetAttribute("Active") then
            TweenService:Create(btn, TweenInfo.new(0.18), { BackgroundTransparency = 0.7 }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.18), { Transparency = 0.4 }):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        if not btn:GetAttribute("Active") then
            TweenService:Create(btn, TweenInfo.new(0.18), { BackgroundTransparency = 0.82 }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.18), { Transparency = 0.7 }):Play()
        end
    end)

    btn.MouseButton1Click:Connect(function()
        playSfx(SFX_CLICK, 0.35, 1.05)

        for _, item in ipairs(allScriptButtons) do
            if item.TabName == tabName and not item.IsToggle then
                item.Button:SetAttribute("Active", false)
                TweenService:Create(item.Button, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BackgroundTransparency = 0.82
                }):Play()
                TweenService:Create(item.Stroke, TweenInfo.new(0.2), { Transparency = 0.7 }):Play()
            end
        end

        btn:SetAttribute("Active", true)
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(0, 140, 255),
            BackgroundTransparency = 0.15
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), { Transparency = 0.05 }):Play()

        task.spawn(function()
            local flash = Instance.new("Frame")
            flash.Size = UDim2.new(1, 0, 1, 0)
            flash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            flash.BackgroundTransparency = 0.7
            flash.BorderSizePixel = 0
            flash.ZIndex = 60
            flash.Parent = btn
            Instance.new("UICorner", flash).CornerRadius = UDim.new(0, 10)
            TweenService:Create(flash, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
            task.delay(0.4, function() if flash and flash.Parent then flash:Destroy() end end)
        end)

        callback()
    end)

    btn.Parent = tabFrame
end

