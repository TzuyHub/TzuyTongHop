local SFX_CLICK  = "rbxassetid://6895079853"
local SFX_WHOOSH = "rbxassetid://876939830"

local function playSfx(soundId, volume, pitch)
    task.spawn(function()
        local s = Instance.new("Sound")
        s.SoundId = soundId or SFX_CLICK
        s.Volume = volume or 0.35
        s.PlaybackSpeed = pitch or 1
        s.Parent = screenGui
        s:Play()
        s.Ended:Connect(function() if s then s:Destroy() end end)
        task.delay(3, function() if s and s.Parent then s:Destroy() end end)
    end)
end

