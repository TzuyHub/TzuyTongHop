        rainbowBtn.Font = Enum.Font.GothamBold
        rainbowBtn.TextSize = 12
        rainbowBtn.TextXAlignment = Enum.TextXAlignment.Left
        rainbowBtn.AutoButtonColor = false
        rainbowBtn.ZIndex = 63
        rainbowBtn.Parent = optionContainer
        Instance.new("UICorner", rainbowBtn).CornerRadius = UDim.new(0, 6)

        rainbowBtn.MouseButton1Click:Connect(function()
            playSfx(SFX_CLICK, 0.3)
            selectedLbl.Text = "Cầu Vồng (Rainbow) ▾"
            isRainbowBorder = true
            isOpen = false
            TweenService:Create(dropdownFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, -10, 0, 50)
            }):Play()
        end)
        table.insert(createdColorButtons, {Button = rainbowBtn, Name = "cầu vồng rainbow"})
    end

    for index, colorData in ipairs(masterColors) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, -5, 0, 32)
        optBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        optBtn.BackgroundTransparency = 0.92
        optBtn.Text = "  " .. colorData[1]
        optBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
        optBtn.Font = Enum.Font.Gotham
        optBtn.TextSize = 12
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.AutoButtonColor = false
        optBtn.ZIndex = 63
        optBtn.Parent = optionContainer

        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 6)

        local colorPreview = Instance.new("Frame")
        colorPreview.Size = UDim2.new(0, 16, 0, 16)
        colorPreview.Position = UDim2.new(1, -24, 0.5, -8)
        colorPreview.BackgroundColor3 = colorData[2]
        colorPreview.BorderSizePixel = 0
        colorPreview.ZIndex = 64
        colorPreview.Parent = optBtn
        Instance.new("UICorner", colorPreview).CornerRadius = UDim.new(0, 4)

        table.insert(createdColorButtons, {Button = optBtn, Name = string.lower(colorData[1])})

        optBtn.MouseEnter:Connect(function()
            TweenService:Create(optBtn, TweenInfo.new(0.12), {
                BackgroundTransparency = 0.82
            }):Play()
        end)
        optBtn.MouseLeave:Connect(function()
            TweenService:Create(optBtn, TweenInfo.new(0.12), {
                BackgroundTransparency = 0.92
            }):Play()
        end)

        optBtn.MouseButton1Click:Connect(function()
            playSfx(SFX_CLICK, 0.3)
            selectedLbl.Text = colorData[1] .. " ▾"

            if isBorder then
                isRainbowBorder = false
                btnStroke.Color = colorData[2]
                if mainStroke then mainStroke.Color = colorData[2] end
            else
                mainFrame.BackgroundColor3 = colorData[2]
                mainFrame.BackgroundTransparency = colorData[3] or 0.35
            end

            isOpen = false
            TweenService:Create(dropdownFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, -10, 0, 50)
            }):Play()
        end)
    end

    colorSearchBox:GetPropertyChangedSignal("Text"):Connect(function()
        local filter = string.lower(colorSearchBox.Text)
        for _, item in ipairs(createdColorButtons) do
            item.Button.Visible = (filter == "" or string.find(item.Name, filter, 1, true)) and true or false
        end
    end)
end

