-- ---- Anti-Kick (client-side __namecall) ----
local kickHooked = false
local oldNamecall = nil
local function installKickHook()
    if kickHooked or not hookmetamethod or not getnamecallmethod then return end
    kickHooked = true
    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            if antiConfig.AntiKick and self == player then
                local method = getnamecallmethod()
                if (method == "Kick" or method == "kick") and not checkcaller() then
                    warn("[Tzuy Anti] Đã chặn Kick client-side")
                    return nil
                end
            end
            return oldNamecall(self, ...)
        end))
    end)
end
installKickHook()

