local allScriptButtons = {}

local function createTabContent(name)
    local sf = Instance.new("ScrollingFrame")
    sf.Name = name .. "Content"
    sf.Size = UDim2.new(1, 0, 1, 0)
    sf.BackgroundTransparency = 1
    sf.BorderSizePixel = 0
    sf.ScrollBarThickness = 4
    sf.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 100)
    sf.Visible = false
    sf.ZIndex = 52
    sf.Parent = contentContainer

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = sf

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        sf.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)

    tabs[name] = sf
    return sf
end

local function switchTab(name)
    for tabName, frame in pairs(tabs) do
        frame.Visible = (tabName == name)
    end
    for btnName, btn in pairs(tabButtons) do
        if btnName == name then
            -- Khi được chọn
            btn.BackgroundColor3 = Color3.fromRGB(0, 140, 255)
            btn.BackgroundTransparency = 0.15
            btn.TextColor3 = TEXT_PURE_BLACK
        else
            -- Khi không được chọn
            if btn:GetAttribute("IsSubTab") then
                -- Style cho Tab con (Main, Kaitun, Hop)
                btn.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
                btn.BackgroundTransparency = 0.3
                btn.TextColor3 = TEXT_GREY_LIGHT
            else
                -- Style cho Tab phẳng (Steal Egg, Settings)
                btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                btn.BackgroundTransparency = 0.85
                btn.TextColor3 = TEXT_BLACK
            end
        end
    end
    activeTab = name
end

