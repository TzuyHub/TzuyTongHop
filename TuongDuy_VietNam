local tabs, tabButtons, activeTab, allScriptButtons = {}, {}, nil, {}

local function createTabContent(name)
    local sf = Instance.new("ScrollingFrame")
    sf.Name                         = name .. "Content"
    sf.Size                         = UDim2.new(1, 0, 1, 0)
    sf.BackgroundTransparency       = 1
    sf.BorderSizePixel              = 0
    sf.Visible                      = false
    sf.ZIndex                       = 52
    sf.CanvasSize                   = UDim2.new(0, 0, 0, 0)
    sf.AutomaticCanvasSize          = Enum.AutomaticSize.Y
    sf.ScrollingDirection           = Enum.ScrollingDirection.Y
    sf.ScrollBarThickness           = 4
    sf.ScrollBarImageColor3         = Color3.fromRGB(0, 140, 255)
    sf.ScrollBarImageTransparency   = 0.1
    sf.ScrollingEnabled             = true
    sf.ElasticBehavior              = Enum.ElasticBehavior.WhenScrollable
    sf.Parent                       = contentContainer

    local layout = Instance.new("UIListLayout")
    layout.Padding   = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent    = sf

    local padding = Instance.new("UIPadding")
    padding.PaddingTop    = UDim.new(0, 4)
    padding.PaddingBottom = UDim.new(0, 10)
    padding.PaddingRight  = UDim.new(0, 8)
    padding.Parent        = sf

    tabs[name] = sf
    return sf
end

local function switchTab(name)
    for tabName, frame in pairs(tabs) do
        frame.Visible = (tabName == name)
        if tabName == name then frame.CanvasPosition = Vector2.new(0, 0) end
    end
    for btnName, btn in pairs(tabButtons) do
        if btnName == name then
            btn.BackgroundColor3       = Color3.fromRGB(0, 140, 255)
            btn.BackgroundTransparency = 0.15
            btn.TextColor3             = TEXT_WHITE
        else
            if btn:GetAttribute("IsSubTab") then
                btn.BackgroundColor3       = Color3.fromRGB(35, 40, 50)
                btn.BackgroundTransparency = 0.3
                btn.TextColor3             = TEXT_GREY_LIGHT
            else
                btn.BackgroundColor3       = Color3.fromRGB(255, 255, 255)
                btn.BackgroundTransparency = 0.85
                btn.TextColor3             = TEXT_BLACK
            end
        end
    end
    activeTab = name
end

local function addSidebarButton(name, iconText)
    local btn = Instance.new("TextButton")
    btn.Name                   = name .. "TabBtn"
