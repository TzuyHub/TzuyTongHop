local akToastToken = 0
local akBarTween

local function akNotify(msg)
    if AK_Unloaded then return end
    akToastToken += 1
    local my = akToastToken
    akMsg.Text    = msg
    akFrame.Visible = true
    if akBarTween then akBarTween:Cancel() end
    akBar.Size = UDim2.new(1, 0, 0, 3)
    akBarTween = TweenService:Create(akBar, TweenInfo.new(TOAST_START, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 3),
    })
    akBarTween:Play()
    task.spawn(function()
        local steps = math.floor(TOAST_START / TOAST_STEP + 0.5)
        for i = steps, 1, -1 do
            if akToastToken ~= my then return end
            akCount.Text = string.format("%.1fs", i * TOAST_STEP)
            task.wait(TOAST_STEP)
        end
        if akToastToken == my then akFrame.Visible = false end
    end)
end

