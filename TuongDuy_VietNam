-- ================= ADAPTIVE SCALE HUB =================
local isAnimating = false
local baseScale = 1

local function updateScale()
    local cam = workspace.CurrentCamera
    if cam then
        local vp = cam.ViewportSize
        baseScale = math.min(vp.X / 950, vp.Y / 600)
        if not isAnimating then uiScale.Scale = baseScale end
    end
end
updateScale()
local hubCamConn
local function bindHubCam()
    if hubCamConn then hubCamConn:Disconnect(); hubCamConn = nil end
    updateScale()
    if workspace.CurrentCamera then
        hubCamConn = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
    end
end
bindHubCam()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindHubCam)

-- ================= KÉO MENU =================
local menuDragging, menuDragStart, menuStartPos = false, nil, nil
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        menuDragging = true; menuDragStart = input.Position; menuStartPos = mainFrame.Position
    end
end)

local btnDragging, btnDragStart, btnStartPos, wasDragged = false, nil, nil, false
button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        btnDragging = true; wasDragged = false; btnDragStart = input.Position; btnStartPos = button.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if menuDragging and workspace.CurrentCamera then
            local delta = input.Position - menuDragStart
            local newX = menuStartPos.X.Offset + delta.X
            local newY = menuStartPos.Y.Offset + delta.Y
            local vp = workspace.CurrentCamera.ViewportSize
            newX = math.clamp(newX, -mainFrame.AbsoluteSize.X / 2 + 100, vp.X - 100)
            newY = math.clamp(newY, -mainFrame.AbsoluteSize.Y / 2 + 50,  vp.Y - 50)
            mainFrame.Position = UDim2.new(menuStartPos.X.Scale, newX, menuStartPos.Y.Scale, newY)
        end
        if btnDragging then
            local delta = input.Position - btnDragStart
            if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then wasDragged = true end
            button.Position = UDim2.new(btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X, btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y)
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        menuDragging = false; btnDragging = false
    end
end)

-- ================= SHOW / HIDE =================
local function showMenu()
    mainFrame.Visible = true
    isAnimating = true
    uiScale.Scale = baseScale * 0.65
    mainFrame.BackgroundTransparency = 1
    mainStroke.Transparency = 1
    TweenService:Create(uiScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale }):Play()
    TweenService:Create(mainFrame, TweenInfo.new(0.3), { BackgroundTransparency = 0.05 }):Play()
    TweenService:Create(mainStroke, TweenInfo.new(0.3), { Transparency = 0.2 }):Play()
    task.delay(0.4, function() isAnimating = false end)
end

local function hideMenu()
    isAnimating = true
    TweenService:Create(uiScale, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = baseScale * 0.6 }):Play()
    TweenService:Create(mainFrame, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
    TweenService:Create(mainStroke, TweenInfo.new(0.25), { Transparency = 1 }):Play()
    task.delay(0.25, function()
        mainFrame.Visible = false
        uiScale.Scale = baseScale
        isAnimating = false
    end)
end

button.MouseButton1Click:Connect(function()
    if wasDragged then wasDragged = false; return end
    playSfx(SFX_WHOOSH, 0.4)
    if mainFrame.Visible then hideMenu() else showMenu() end
end)

task.spawn(function()
    task.wait(0.1)
    showMenu()
end)

