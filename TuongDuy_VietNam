    tLbl.Font = Enum.Font.GothamBold
    tLbl.TextSize = 14
    tLbl.TextXAlignment = Enum.TextXAlignment.Left
    tLbl.ZIndex = 54
    tLbl.Parent = btn

    local dLbl = Instance.new("TextLabel")
    dLbl.Size = UDim2.new(1, -20, 0, 18)
    dLbl.Position = UDim2.new(0, 15, 0, 26)
    dLbl.BackgroundTransparency = 1
    dLbl.Text = desc
    dLbl.TextColor3 = Color3.fromRGB(180, 190, 210)
    dLbl.Font = Enum.Font.Gotham
    dLbl.TextSize = 11
    dLbl.TextXAlignment = Enum.TextXAlignment.Left
    dLbl.ZIndex = 54
    dLbl.Parent = btn

    local itemData = {
        Button = btn,
        Stroke = stroke,
        Title = string.lower(title),
        Desc = string.lower(desc),
        TabName = tabName
    }
    table.insert(allScriptButtons, itemData)

    btn.MouseEnter:Connect(function()
        if not btn:GetAttribute("Active") then
            TweenService:Create(btn, TweenInfo.new(0.18), {
                BackgroundTransparency = 0.82
            }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.18), {
                Transparency = 0.5
            }):Play()
        end
    end)

    btn.MouseLeave:Connect(function()
        if not btn:GetAttribute("Active") then
            TweenService:Create(btn, TweenInfo.new(0.18), {
                BackgroundTransparency = 0.90
            }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.18), {
                Transparency = 0.75
            }):Play()
        end
    end)

    btn.MouseButton1Click:Connect(function()
        playSfx(SFX_CLICK, 0.35, 1.05)

        for _, item in ipairs(allScriptButtons) do
            if item.TabName == tabName and not item.IsToggle then
                item.Button:SetAttribute("Active", false)
                TweenService:Create(item.Button, TweenInfo.new(0.2), {
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BackgroundTransparency = 0.90
                }):Play()
                TweenService:Create(item.Stroke, TweenInfo.new(0.2), {
                    Transparency = 0.75
                }):Play()
            end
        end

        btn:SetAttribute("Active", true)
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(0, 140, 255),
            BackgroundTransparency = 0.20
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {
            Transparency = 0.1
        }):Play()

        task.spawn(function()
            local flash = Instance.new("Frame")
            flash.Size = UDim2.new(1, 0, 1, 0)
            flash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            flash.BackgroundTransparency = 0.7
            flash.BorderSizePixel = 0
            flash.ZIndex = 60
            flash.Parent = btn
            Instance.new("UICorner", flash).CornerRadius = UDim.new(0, 10)
            TweenService:Create(flash, TweenInfo.new(0.35), {
                BackgroundTransparency = 1
            }):Play()
            task.delay(0.4, function() if flash and flash.Parent then flash:Destroy() end end)
        end)

        callback()
    end)

    btn.Parent = tabFrame
end

