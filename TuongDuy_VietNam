local tabs = {}
local tabButtons = {}
local activeTab = nil

local function createTabContent(name)
    local scrollingFrame = Instance.new("ScrollingFrame")
    scrollingFrame.Name = name .. "Content"
    scrollingFrame.Size = UDim2.new(1, 0, 1, 0)
    scrollingFrame.BackgroundTransparency = 1
    scrollingFrame.BorderSizePixel = 0
    scrollingFrame.ScrollBarThickness = 4
    scrollingFrame.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
    scrollingFrame.Visible = false
    scrollingFrame.ZIndex = 52
    scrollingFrame.Parent = contentContainer
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = scrollingFrame
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 20)
    end)
    
    tabs[name] = scrollingFrame
    return scrollingFrame
end

local function switchTab(name)
    for tabName, frame in pairs(tabs) do
        frame.Visible = (tabName == name)
    end
    for btnName, btn in pairs(tabButtons) do
        if btnName == name then
            btn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
            btn.BackgroundTransparency = 0.2
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            btn.BackgroundTransparency = 0.93
            btn.TextColor3 = Color3.fromRGB(200, 210, 230)
        end
    end
    activeTab = name
end

local function addSidebarButton(name, iconText)
    local btn = Instance.new("TextButton")
    btn.Name = name .. "TabBtn"
    btn.Size = UDim2.new(1, -5, 0, 42)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundTransparency = 0.93
    btn.Text = "  " .. (iconText or "📁") .. "   " .. name
    btn.TextColor3 = Color3.fromRGB(200, 210, 230)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.ZIndex = 52
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
    
    btn.Parent = sidebar
    tabButtons[name] = btn
    createTabContent(name)
end

-- Lưu trữ danh sách các nút tính năng để quản lý hiệu ứng Active khi chạm/bấm
local scriptButtonsPerTab = {}

local function addScriptButton(tabName, title, desc, callback)
    local tabFrame = tabs[tabName]
    if not tabFrame then return end
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 52)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundTransparency = 0.90
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.ZIndex = 53
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.7
    stroke.Thickness = 1
    stroke.Parent = btn
    
    local tLbl = Instance.new("TextLabel")
    tLbl.Size = UDim2.new(1, -20, 0, 22)
    tLbl.Position = UDim2.new(0, 15, 0, 6)
    tLbl.BackgroundTransparency = 1
    tLbl.Text = title
    tLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    tLbl.Font = Enum.Font.GothamBold
    tLbl.TextSize = 14
    tLbl.TextXAlignment = Enum.TextXAlignment.Left
    tLbl.ZIndex = 54
    tLbl.Parent = btn
    
    local dLbl = Instance.new("TextLabel")
    dLbl.Size = UDim2.new(1, -20, 0, 18)
    dLbl.Position = UDim2.new(0, 15, 0, 26)
    dLbl.BackgroundTransparency = 1
    dLbl.Text = desc
    dLbl.TextColor3 = Color3.fromRGB(180, 190, 210)
    dLbl.Font = Enum.Font.Gotham
    dLbl.TextSize = 11
    dLbl.TextXAlignment = Enum.TextXAlignment.Left
    dLbl.ZIndex = 54
    dLbl.Parent = btn
    
    if not scriptButtonsPerTab[tabName] then
        scriptButtonsPerTab[tabName] = {}
    end
    table.insert(scriptButtonsPerTab[tabName], {Button = btn, Stroke = stroke})
    
    -- Hiệu ứng khi chạm/bấm vào tính năng (Active Highlight State)
    btn.MouseButton1Click:Connect(function()
        -- Reset hiệu ứng của các nút khác trong cùng tab
        for _, item in ipairs(scriptButtonsPerTab[tabName]) do
            TweenService:Create(item.Button, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BackgroundTransparency = 0.90
            }):Play()
            TweenService:Create(item.Stroke, TweenInfo.new(0.2), {
                Transparency = 0.7
            }):Play()
        end
        
        -- Làm nổi bật nút được chạm vào (Active Blue Highlight)
        TweenService:Create(btn, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(0, 140, 255),
            BackgroundTransparency = 0.15
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {
            Transparency = 0.1
        }):Play()
        
        -- Thực thi callback tính năng
        callback()
    end)
    
    btn.Parent = tabFrame
end

