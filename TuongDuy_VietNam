-- ================= ANTI-PACK LOOPS =================
local akLastGoodCFrame = nil

akTrack(RunService.Heartbeat:Connect(function()
    if AK_Unloaded then return end
    local char = player.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if AP.Fling then
        local vel = hrp.AssemblyLinearVelocity
        local ang = hrp.AssemblyAngularVelocity
        if vel.Magnitude > MAX_VEL or ang.Magnitude > MAX_ANG then
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        elseif vel.Magnitude > 1 then
            akLastGoodCFrame = hrp.CFrame
        end
    end

    if AP.Void then
        local dy = workspace.FallenPartsDestroyHeight or -500
        if hrp.Position.Y < math.min(dy + 200, -300) and akLastGoodCFrame then
            pcall(function()
                hrp.CFrame = akLastGoodCFrame
                hrp.AssemblyLinearVelocity  = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end

    if AP.CharReset and akLastGoodCFrame
       and hrp.Position.Magnitude < 15
       and (akLastGoodCFrame.Position - hrp.Position).Magnitude > 100 then
        pcall(function() hrp.CFrame = akLastGoodCFrame end)
    end

    if AP.Ragdoll then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.PlatformStand then
            hum.PlatformStand = false
        end
    end
end))

task.spawn(function()
    while not AK_Unloaded do
        task.wait(0.15)
        if not AP.Weld then continue end
        local char = player.Character
        if not char then continue end
        pcall(function()
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("WeldConstraint") or obj:IsA("Weld") then
                    local p0, p1 = obj.Part0, obj.Part1
                    if p0 and p1
                       and p0:IsDescendantOf(char) ~= p1:IsDescendantOf(char) then
                        obj:Destroy()
                    end
                end
            end
        end)
    end
end)

