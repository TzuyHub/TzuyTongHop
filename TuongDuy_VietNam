getgenv().TzuyAK = {
    State = AK, Pack = AP, Profile = PROFILE_TAG, IsBloxFruits = isBloxFruits,
    Notify = akNotify,
    SetEnabled        = function(v) AK.Enabled      = v and true or false; akNotify(AK.Enabled      and "🛡️ Anti-Kick: BẬT"      or "⛔ Anti-Kick: TẮT") end,
    SetAutoRejoin     = function(v) AK.AutoRejoin   = v and true or false; akNotify(AK.AutoRejoin   and "🔁 Auto Rejoin: BẬT"    or "⏹️ Auto Rejoin: TẮT") end,
    SetHidePrompt     = function(v) AK.HidePrompt   = v and true or false; akNotify(AK.HidePrompt   and "👁️ Ẩn Popup: BẬT"        or "👁️ Ẩn Popup: TẮT") end,
    SetAntiIdle       = function(v) AK.AntiIdle     = v and true or false; akNotify(AK.AntiIdle     and "💤 Anti-Idle: BẬT"       or "💤 Anti-Idle: TẮT") end,
    SetAntiFling      = function(v) AP.Fling        = v and true or false; akNotify(AP.Fling        and "🌀 Anti-Fling: BẬT"      or "🌀 Anti-Fling: TẮT") end,
    SetAntiWeld       = function(v) AP.Weld         = v and true or false; akNotify(AP.Weld         and "🔗 Anti-Weld: BẬT"       or "🔗 Anti-Weld: TẮT") end,
    SetAntiVoid       = function(v) AP.Void         = v and true or false; akNotify(AP.Void         and "🕳️ Anti-Void: BẬT"       or "🕳️ Anti-Void: TẮT") end,
    SetAntiCharReset  = function(v) AP.CharReset    = v and true or false; akNotify(AP.CharReset    and "🔄 Anti-Char-Reset: BẬT"  or "🔄 Anti-Char-Reset: TẮT") end,
    SetAntiRagdoll    = function(v) AP.Ragdoll      = v and true or false; akNotify(AP.Ragdoll      and "🧎 Anti-Ragdoll: BẬT"    or "🧎 Anti-Ragdoll: TẮT") end,
    Unload = function()
        AK_Unloaded = true
        AK.Enabled  = false
        if akOldNamecall then
            pcall(function()
                if typeof(hookmetamethod) == "function" then
                    hookmetamethod(game, "__namecall", akOldNamecall)
                elseif typeof(getrawmetatable) == "function" then
                    local mt = getrawmetatable(game)
                    local setRO = setreadonly or make_writeable
                    if setRO then setRO(mt, false) end
                    mt.__namecall = akOldNamecall
                    if setRO then setRO(mt, true) end
                end
            end)
        end
        if akOldKick and typeof(hookfunction) == "function" then
            pcall(function() hookfunction(player.Kick, akOldKick) end)
        end
        for _, c in ipairs(AK_connections) do
            pcall(function() c:Disconnect() end)
        end
        table.clear(AK_connections)
        if akCamConn then akCamConn:Disconnect(); akCamConn = nil end
        pcall(function() akGui:Destroy() end)
        getgenv().TzuyAK = nil
    end,
}

