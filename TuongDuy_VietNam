-- ================= HOOK CHẶN KICK =================
local function blockKick(src)
    AK.Blocked += 1
    akNotify(string.format("🛡️ Chặn Kick (%s) · #%d", src, AK.Blocked))
end

local TELEPORT_METHODS = {
    Teleport = true, TeleportToPlaceInstance = true, TeleportAsync = true,
}

local akOldNamecall, akOldKick

local function akNamecallHook(self, ...)
    if AK.Enabled then
        local method = getnamecallmethod and getnamecallmethod() or ""
        if typeof(method) == "string" then
            if self == player and string.lower(method) == "kick" then
                blockKick("namecall")
                return
            end
            if self == TeleportService and TELEPORT_METHODS[method] then
                AK.LastTeleport = { method = method, args = table.pack(...) }
                AK.LastIntent   = os.clock()
            end
        end
    end
    return akOldNamecall(self, ...)
end

local akNsHooked = false
if typeof(hookmetamethod) == "function" then
    akNsHooked = pcall(function()
        akOldNamecall = hookmetamethod(game, "__namecall", newcc(akNamecallHook))
    end)
end
if not akNsHooked and typeof(getrawmetatable) == "function" then
    pcall(function()
        local mt = getrawmetatable(game)
        local setRO = setreadonly or make_writeable
        if setRO then setRO(mt, false) end
        akOldNamecall = mt.__namecall
        mt.__namecall = newcc(akNamecallHook)
        if setRO then setRO(mt, true) end
    end)
end

if typeof(hookfunction) == "function" then
    pcall(function()
        akOldKick = hookfunction(player.Kick, newcc(function(self, ...)
            if AK.Enabled and self == player then
                blockKick("direct")
                return
            end
            return akOldKick(self, ...)
        end))
    end)
end

-- ================= AUTO REJOIN =================
local function akRejoin(reason)
    if not AK.AutoRejoin or not AK.Enabled or AK.Rejoining then return end
    local now = os.clock()
    if now - AK.LastRejoin < REJOIN_COOLDOWN then return end
    if now - AK.LastIntent < INTENT_WINDOW then return end
    if now - AK.TeleportFailAt < 4 then return end

    AK.Rejoining  = true
    AK.LastRejoin = now
    AK.Rejoins   += 1
    akNotify("⚠️ " .. reason .. " → vào lại #" .. AK.Rejoins)

    task.spawn(function()
        task.wait(1.5)
        local ok = false
        if game.JobId ~= "" then
            ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
            end)
        end
        if not ok then
            pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
        end
        task.delay(5, function() AK.Rejoining = false end)
    end)
end

akTrack(TeleportService.TeleportInitFailed:Connect(function(plr)
    if plr ~= player or not AK.Enabled then return end
    AK.TeleportFailAt = os.clock()
    local t = AK.LastTeleport
    if not t or AK.TeleportRetry >= TELEPORT_RETRY_MAX then return end
    AK.TeleportRetry += 1
    local attempt = AK.TeleportRetry
    akNotify("🔁 Teleport fail · thử lại " .. attempt .. "/" .. TELEPORT_RETRY_MAX)
    task.delay(2, function()
        pcall(function()
            TeleportService[t.method](TeleportService, table.unpack(t.args, 1, t.args.n))
        end)
    end)
    task.delay(30, function()
        if AK.TeleportRetry == attempt then AK.TeleportRetry = 0 end
    end)
end))

pcall(function()
    akTrack(GuiService.ErrorMessageChanged:Connect(function(msg)
        if not AK.Enabled or not msg or msg == "" then return end
        akRejoin("Mất kết nối")
    end))
end)

-- ================= BẮT POPUP KICK =================
local function isKickText(text)
    if typeof(text) ~= "string" then return false end
    local lower = string.lower(text)
    for _, kw in ipairs(KICK_KEYWORDS) do
        if string.find(lower, kw, 1, true) then return true end
    end
    return false
end

local function akHandlePrompt(obj)
    if not AK.Enabled or not obj then return end
    local nameMatch = string.find(string.lower(obj.Name), "error", 1, true)
    local textMatch = obj:IsA("TextLabel") and isKickText(obj.Text)
    if not (nameMatch or textMatch) then return end
    if AK.HidePrompt then
        task.defer(function()
            pcall(function()
                local root = obj:FindFirstAncestorOfClass("Frame") or obj
                root.Visible = false
            end)
        end)
    end
    akRejoin("Bị đuổi khỏi server")
end

task.spawn(function()
    if AK_Unloaded then return end
    pcall(function()
        local prompt = CoreGui:WaitForChild("RobloxPromptGui", 10)
        if not prompt then return end
        local overlay = prompt:WaitForChild("promptOverlay", 10)
        if not overlay then return end
        for _, c in ipairs(overlay:GetChildren()) do akHandlePrompt(c) end
        akTrack(overlay.ChildAdded:Connect(akHandlePrompt))
        akTrack(overlay.DescendantAdded:Connect(function(d)
            if d:IsA("TextLabel") then
                task.defer(function() akHandlePrompt(d) end)
            end
        end))
    end)
end)

