-- ---- Anti-Fling (optimized) ----
local FLING_SPEED = 200
local lastScan = 0
trackAnti(RunService.Heartbeat:Connect(function(dt)
    if not antiConfig.AntiFling then return end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        local vel = root.AssemblyLinearVelocity
        local ang = root.AssemblyAngularVelocity
        if vel.Magnitude > FLING_SPEED or ang.Magnitude > FLING_SPEED then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
    lastScan += dt
    if lastScan < 0.5 then return end
    lastScan = 0
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            for _, name in ipairs({"HumanoidRootPart", "UpperTorso", "Torso", "Head"}) do
                local part = other.Character:FindFirstChild(name)
                if part and part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end
end))

-- ---- Auto-Rejoin ----
local rejoining = false
local retryCount = 0
local function doRejoin(reason)
    if not antiConfig.AutoRejoin or rejoining then return end
    if retryCount >= antiConfig.MaxRetry then
        warn("[Tzuy Anti] Đã thử " .. retryCount .. " lần, dừng. Lý do: " .. tostring(reason))
        return
    end
    rejoining = true
    retryCount += 1
    local waitTime = math.min(2 * retryCount, 12)
    task.delay(waitTime, function()
        local ok = false
        if retryCount == 1 and game.JobId ~= "" then
            ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
            end)
        end
        if not ok then
            pcall(function() TeleportService:Teleport(game.PlaceId, player) end)
        end
        task.wait(5)
        rejoining = false
        task.delay(60, function() retryCount = 0 end)
    end)
end

local KICK_KEYWORDS = { "kick", "disconnect", "teleport", "permission", "access", "quyền", "lost connection", "mất kết nối" }
local function isKickMessage(msg)
    if not msg or msg == "" then return false end
    local lower = string.lower(msg)
    for _, kw in ipairs(KICK_KEYWORDS) do
        if string.find(lower, kw, 1, true) then return true end
    end
    return false
end

trackAnti(TeleportService.TeleportInitFailed:Connect(function(p, _, msg)
    if p == player then doRejoin("TeleportInitFailed: " .. tostring(msg)) end
end))

pcall(function()
    trackAnti(GuiService.ErrorMessageChanged:Connect(function(msg)
        if isKickMessage(msg) then doRejoin("Error: " .. msg) end
    end))
end)

trackAnti(player.CharacterAdded:Connect(function()
    retryCount = 0
    rejoining = false
end))

-- ---- Anti cleanup ----
local function cleanupAnti()
    for _, c in ipairs(antiConnections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(antiConnections)
    if oldNamecall then
        pcall(function() hookmetamethod(game, "__namecall", oldNamecall) end)
    end
end
getgenv().TzuyAntiCleanup = cleanupAnti

